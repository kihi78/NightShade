<Window x:Class="NightShade.Views.QuickMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightShade"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStartupLocation="Manual">

    <!-- 情報量を最小限にする: ON/OFF ボタンと暗さスライダーのみ -->
    <Border Style="{StaticResource SurfaceBorder}" Width="220">
        <StackPanel>

            <Button Content="{Binding ToggleCaption}"
                    Command="{Binding ToggleOverlayCommand}"
                    Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12" />

            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Width="40" Style="{StaticResource ValueText}">
                    <Run Text="{Binding DarknessPercent, Mode=OneWay}" /><Run Text=" %" />
                </TextBlock>
                <Slider Style="{StaticResource DarkSlider}"
                        Minimum="0"
                        Maximum="0.9"
                        Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SmallChange="{Binding OpacityStep, Mode=OneWay}"
                        LargeChange="{Binding OpacityStep, Mode=OneWay}" />
            </DockPanel>

        </StackPanel>
    </Border>
</Window>
